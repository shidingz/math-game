# Copy values into ignored .env.service.local in the project root.
# Generate your own private password; this example intentionally cannot start.
PET_SERVICE_ACCESS_CODE=
PUBLIC_BASE_URL=https://YOUR-TUNNEL-HOST.example
PET_SERVICE_ALLOWED_ORIGINS=https://YOUR-ACCOUNT.github.io,http://127.0.0.1:8798
PET_SERVICE_HOST=127.0.0.1
PET_SERVICE_PORT=8799
PET_SERVICE_DATA_DIR=artifacts/pet-service
PET_SERVICE_POLL_MS=45000
PET_SERVICE_MAX_DAILY_JOBS=10
PET_SERVICE_MAX_DAILY_OWNER_JOBS=3
PET_SERVICE_MAX_PENDING_JOBS=10
PET_SERVICE_MAX_PENDING_OWNER_JOBS=2
PET_SERVICE_MAX_PHOTOS_PER_OWNER=60
PET_SERVICE_MAX_PHOTOS=300
PET_SERVICE_SESSION_DAYS=30
PET_SERVICE_MAX_JOB_AGE_MS=86400000
# Keep API302_API_KEY in the project's existing ignored .env.local, never in the client.
